# Basewise Backend — Environment Variables
# Copy this to .env and fill in your values

# --- Basewise System Database (Supabase Postgres) ---
# Use the Session mode pooler connection string (port 5432)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
# Primary: gpt-oss-120b on Groq (free tier — no card needed).
# Free tier: 30 RPM / 1000 RPD / 8K TPM, ~500 tok/s.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Fallback: Gemini 3.6 Flash (Google AI Studio, free tier — no card needed).
# CAUTION: free tier caps at ~20 requests/day per project+model (confirmed Aug 2026),
# which is why it's the FALLBACK, not primary. Model names are generation-specific —
# gemini-2.5-flash is retired for new keys; use the current generation.
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Free-only model config (no paid models — we run without credits).
# Availability/limits change; test with scripts/test_models.py before relying on it.
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FALLBACK_LLM_MODELS=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- E2B Sandbox ---
E2B_API_KEY=your-e2b-api-key-here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
